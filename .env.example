# Django
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (local — used when DATABASE_URL is not set)
DB_NAME=porter_db
DB_USER=porter_user
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Database (staging/production — optional; overrides DB_* when set)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Twilio (use the number from your Twilio console — not your personal mobile)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Optional dev only — leave empty here; add real numbers only in your private .env
OTP_BYPASS_NUMBERS=
